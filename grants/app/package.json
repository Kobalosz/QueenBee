{
  "name": "queenbee-grants",
  "productName": "Grants",
  "version": "0.1.0",
  "private": true,
  "description": "The owner's window onto the QueenBee grant agent: what it wrote and sent, and what needs the owner.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "demo:setup": "electron . --demo --setup",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/store.js && node --check src/setup.js && node --check src/system.js && node --check src/demo.js && node --check src/renderer/app.js && node --check src/renderer/setup.js && node src/selftest.js",
    "dist": "electron-builder --win --mac",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.queenbee.grants",
    "productName": "Grants",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/@fontsource-variable/atkinson-hyperlegible-next/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grants"
    }
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0"
  }
}
